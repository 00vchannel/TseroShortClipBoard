<Window x:Class="ClipboardApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="零零快捷剪貼板" Width="1100" Height="740" MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown"
        Background="{DynamicResource PageBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Microsoft JhengHei UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="21"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style x:Key="QuietLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
            <Style x:Key="ManagerListItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource CardBrush}" CornerRadius="20" Padding="20,14">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="37" Height="37" Background="{DynamicResource AccentBrush}" CornerRadius="12" Margin="0,0,12,0">
                        <TextBlock Text="✦" Foreground="#101112" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="零零快捷剪貼板" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="你的常用文字，隨時取用" Style="{StaticResource QuietLabel}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="設定與資料 ▾" Click="OpenAppMenu_Click" Margin="0,0,8,0">
                        <Button.ContextMenu><ContextMenu>
                            <MenuItem Header="設定" Click="Settings_Click"/>
                            <MenuItem Header="手動備份" Click="Backup_Click"/>
                            <MenuItem Header="還原備份" Click="Restore_Click"/>
                        </ContextMenu></Button.ContextMenu>
                    </Button>
                    <Button Content="快捷面板" Style="{StaticResource AccentButton}" Click="OpenQuickPanel_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" MinWidth="320"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="360"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource CardBrush}" CornerRadius="20" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="5,4,0,12">
                        <TextBlock x:Name="ListTitle" Text="全部文字" Style="{StaticResource SectionTitle}" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="ListCount" Text="0 筆" Style="{StaticResource QuietLabel}" DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="8,0,0,2"/>
                    </DockPanel>
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ComboBox x:Name="ViewSelector" Grid.Column="0" Height="38" DisplayMemberPath="Name" SelectionChanged="ViewSelector_SelectionChanged" ToolTip="選擇要管理的內容"/>
                        <ComboBox x:Name="CategoryList" Grid.Column="2" Height="38" DisplayMemberPath="Name" SelectionChanged="CategoryList_SelectionChanged" ToolTip="篩選分類"/>
                        <Button Grid.Column="3" Content="分類 ▾" Click="OpenCategoryMenu_Click" Margin="7,0,0,0">
                            <Button.ContextMenu><ContextMenu>
                                <MenuItem Header="新增分類" Click="AddCategory_Click"/>
                                <MenuItem Header="重新命名目前分類" Click="RenameCategory_Click"/>
                                <MenuItem Header="刪除目前分類" Click="DeleteCategory_Click"/>
                                <Separator/>
                                <MenuItem Header="目前分類向上移" Click="MoveCategoryUp_Click"/>
                                <MenuItem Header="目前分類向下移" Click="MoveCategoryDown_Click"/>
                            </ContextMenu></Button.ContextMenu>
                        </Button>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" ToolTip="搜尋標題與內容"/>
                        <TextBlock x:Name="SearchHint" Text="⌕  搜尋標題或內容" Foreground="{DynamicResource MutedBrush}"
                                   Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                    <DockPanel Grid.Row="3" LastChildFill="False" Margin="0,0,0,9">
                        <Button x:Name="NewSnippetButton" Content="＋ 新增文字" Style="{StaticResource AccentButton}" Click="NewSnippet_Click" DockPanel.Dock="Left"/>
                        <Button x:Name="ModeActionButton" Content="更多操作 ▾" Click="OpenModeMenu_Click" DockPanel.Dock="Right">
                            <Button.ContextMenu><ContextMenu>
                                <MenuItem x:Name="MoveAction" Header="搬移選取文字" Click="MoveSelected_Click"/>
                                <MenuItem x:Name="DeleteAction" Header="刪除選取文字" Click="DeleteSelected_Click"/>
                                <MenuItem x:Name="PromoteAction" Header="將選取歷史轉存為常用文字" Click="PromoteHistory_Click"/>
                                <MenuItem x:Name="PauseHistoryButton" Header="暫停記錄" Click="PauseHistory_Click"/>
                                <MenuItem x:Name="ClearHistoryAction" Header="清空複製歷史" Click="ClearHistory_Click"/>
                                <MenuItem x:Name="DiscardDraftsAction" Header="放棄選取草稿" Click="DiscardSelectedDrafts_Click"/>
                                <MenuItem x:Name="RestoreAction" Header="復原選取文字" Click="RestoreSelected_Click"/>
                                <MenuItem x:Name="PermanentDeleteAction" Header="永久刪除選取文字" Click="PermanentlyDeleteSelected_Click"/>
                            </ContextMenu></Button.ContextMenu>
                        </Button>
                    </DockPanel>
                    <AdornerDecorator Grid.Row="4">
                    <Grid>
                    <ListBox x:Name="SnippetList" SelectionMode="Extended" SelectionChanged="SnippetList_SelectionChanged" Tag="Visible"
                             ItemContainerStyle="{StaticResource ManagerListItem}"
                             AllowDrop="True" DragOver="SnippetList_DragOver" DragLeave="SnippetList_DragLeave" Drop="SnippetList_Drop" PreviewMouseMove="SnippetHandle_MouseMove"
                             PreviewMouseLeftButtonUp="SnippetList_PreviewMouseLeftButtonUp">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="{DynamicResource ListTextHeight}" ClipToBounds="True">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="⠿" FontSize="22" Foreground="{DynamicResource MutedBrush}"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" Cursor="SizeAll"
                                               ToolTip="拖曳以調整目前分類內的順序" Visibility="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                               PreviewMouseLeftButtonDown="SnippetHandle_PreviewMouseLeftButtonDown" MouseMove="SnippetHandle_MouseMove"/>
                                    <StackPanel Grid.Column="1" ClipToBounds="True">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" Height="{DynamicResource ListTitleHeight}" ClipToBounds="True"/>
                                    <TextBlock Text="{Binding Content}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Height="{DynamicResource ListPreviewHeight}" ClipToBounds="True" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="🗑" Width="34" Height="34" Padding="0" Margin="8,0,0,0"
                                            ToolTip="移至垃圾桶（可復原）" AutomationProperties.Name="將這筆文字移至垃圾桶"
                                            Visibility="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            Click="DeleteSnippetRow_Click"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <ListBox x:Name="HistoryList" SelectionChanged="HistoryList_SelectionChanged" Visibility="Collapsed"
                             ItemContainerStyle="{StaticResource ManagerListItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Height="{DynamicResource ListTextHeight}" ClipToBounds="True">
                                    <TextBlock Text="{Binding CapturedAt, StringFormat={}{0:yyyy/MM/dd HH:mm}}" Style="{StaticResource QuietLabel}" Height="{DynamicResource ListTitleHeight}"/>
                                    <TextBlock Text="{Binding Content}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               Height="{DynamicResource ListPreviewHeight}" ClipToBounds="True" Margin="0,5,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <ListBox x:Name="TrashList" SelectionMode="Extended" SelectionChanged="TrashList_SelectionChanged" Visibility="Collapsed"
                             ItemContainerStyle="{StaticResource ManagerListItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Height="{DynamicResource ListTextHeight}" ClipToBounds="True">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" Height="{DynamicResource ListTitleHeight}" ClipToBounds="True"/>
                                    <TextBlock Text="{Binding Content}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                               Foreground="{DynamicResource MutedBrush}" Height="{DynamicResource ListPreviewHeight}" ClipToBounds="True" Margin="0,5,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </Grid>
                    </AdornerDecorator>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"/>
            <Border Grid.Column="2" Background="{DynamicResource CardBrush}" CornerRadius="20" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,15">
                        <TextBlock x:Name="EditorHeading" Text="選取文字" Style="{StaticResource SectionTitle}" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="DraftStatus" Text="" Style="{StaticResource QuietLabel}" DockPanel.Dock="Right" VerticalAlignment="Bottom"/>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="標題" Style="{StaticResource QuietLabel}" Margin="0,0,0,5"/>
                    <TextBox x:Name="TitleBox" Grid.Row="2" TextChanged="Editor_TextChanged" ToolTip="標題" Margin="0,0,0,15"/>
                    <Grid Grid.Row="3" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="分類" Style="{StaticResource QuietLabel}" VerticalAlignment="Center" Margin="0,0,13,0"/>
                        <ComboBox x:Name="EditorCategory" Grid.Column="1" Height="38" Background="{DynamicResource RaisedBrush}"
                                  Foreground="{DynamicResource TextBrush}" SelectionChanged="EditorCategory_SelectionChanged"
                                  DisplayMemberPath="Name" SelectedValuePath="Id"/>
                    </Grid>
                    <TextBox x:Name="ContentBox" Grid.Row="4" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                             VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" SpellCheck.IsEnabled="False"
                             TextChanged="Editor_TextChanged" FontSize="15"/>
                    <Button x:Name="SaveButton" Grid.Row="5" HorizontalAlignment="Right" Margin="0,14,0,0"
                            Content="儲存" Style="{StaticResource AccentButton}" MinWidth="94" Click="Save_Click"/>
                </Grid>
            </Border>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="3" Style="{StaticResource QuietLabel}" Margin="6,11,0,0" Text="準備就緒"/>
    </Grid>
</Window>
