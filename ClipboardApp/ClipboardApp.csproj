<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ZeroZeroClipboard</AssemblyName>
    <RootNamespace>ClipboardApp</RootNamespace>
    <Version>2.1.5</Version>
    <StartupObject>ClipboardApp.Program</StartupObject>
    <DefineConstants Condition="'$(UpdateTestBuild)' == 'true'">$(DefineConstants);UPDATE_TEST_BUILD</DefineConstants>
    <ApplicationIcon>..\assets\00monstericon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ClipboardCore\ClipboardCore.csproj" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="ClipboardApp.Smoke" /></ItemGroup>
</Project>
