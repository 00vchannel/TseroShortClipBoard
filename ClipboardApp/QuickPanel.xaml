<Window x:Class="ClipboardApp.QuickPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClipboardApp"
        Width="620" Height="760" MinWidth="360" MinHeight="450" ResizeMode="CanResizeWithGrip"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        Topmost="True" Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Background="{DynamicResource PageBrush}" CornerRadius="26" BorderBrush="#3A3F3D" BorderThickness="1" Padding="19">
        <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="12" Opacity="0.5"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="2,0,2,15">
                <Grid x:Name="PanelHeader" SizeChanged="PanelHeader_SizeChanged">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="PanelTitle" Text="{x:Static local:AppVersion.QuickPanelTitle}" FontSize="23" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <WrapPanel x:Name="HeaderActions" HorizontalAlignment="Right" SizeChanged="PanelHeader_SizeChanged">
                        <Button x:Name="UpdateButton" Content="更新並重啟" Click="Update_Click" Visibility="Collapsed"
                                Margin="0,0,8,0" Padding="11,4" AutomationProperties.Name="下載更新並自動重啟"/>
                        <Button Content="管理" Click="Manager_Click" Margin="0,0,8,0" Padding="11,4" ToolTip="開啟管理視窗"/>
                        <Button Content="✕" Click="Close_Click" Padding="9,4" AutomationProperties.Name="收起快捷面板"/>
                    </WrapPanel>
                </Grid>
                <StackPanel x:Name="UpdateProgressArea" Visibility="Collapsed" Margin="0,10,0,0">
                    <ProgressBar x:Name="UpdateProgress" Height="4" Minimum="0" Maximum="100" IsHitTestVisible="False"
                                 AutomationProperties.Name="更新下載進度"/>
                    <DockPanel Margin="0,5,0,0">
                        <Button x:Name="CancelUpdateButton" Content="取消" DockPanel.Dock="Right" Padding="9,3" Click="CancelUpdate_Click"/>
                        <Button x:Name="RetryUpdateButton" Content="重試" DockPanel.Dock="Right" Padding="9,3" Click="Update_Click" Visibility="Collapsed"/>
                        <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
            </StackPanel>
            <Grid Grid.Row="1">
                <TextBox x:Name="SearchBox" Height="44" TextChanged="SearchBox_TextChanged" ToolTip="搜尋標題與內容"/>
                <TextBlock x:Name="SearchHint" Text="⌕  搜尋標題或內容" Foreground="{DynamicResource MutedBrush}"
                           Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
            <Grid Grid.Row="2" Margin="0,11,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="SnippetsTab" Content="常用文字" Style="{StaticResource AccentButton}" Click="SnippetsTab_Click" Margin="0,0,7,0"/>
                <Button x:Name="HistoryTab" Grid.Column="1" Content="複製歷史" Click="HistoryTab_Click"/>
            </Grid>
            <Grid x:Name="CategoryArea" Grid.Row="3" Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ScrollViewer x:Name="CategoryScroller" MaxHeight="126" Margin="0,0,8,0"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <WrapPanel x:Name="CategoryChips" Width="{Binding ViewportWidth, ElementName=CategoryScroller}"/>
            </ScrollViewer>
                <Button x:Name="OfficialCategoryButton" Grid.Column="1" Content="官方提示語"
                        VerticalAlignment="Top" Padding="11,7" Margin="0,0,0,7"
                        ToolTip="內建唯讀提示語" Click="OfficialCategory_Click"/>
            </Grid>
            <AdornerDecorator Grid.Row="4">
            <ListBox x:Name="ResultList"
                     PreviewMouseLeftButtonUp="ResultList_PreviewMouseLeftButtonUp"
                     PreviewMouseMove="ResultList_PreviewMouseMove">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="{DynamicResource ListTextHeight}" ClipToBounds="True">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border x:Name="DragHandle" Grid.Column="0" Margin="0,0,12,0" Padding="3,4"
                                    VerticalAlignment="Center" Background="Transparent" Cursor="SizeAll"
                                    IsEnabled="{Binding CanReorder}" ToolTip="拖曳調整此分類內的順序"
                                    PreviewMouseLeftButtonDown="DragHandle_PreviewMouseLeftButtonDown"
                                    PreviewMouseLeftButtonUp="DragHandle_PreviewMouseLeftButtonUp">
                                <TextBlock Text="⠿" FontSize="19" Foreground="{DynamicResource MutedBrush}"/>
                            </Border>
                            <StackPanel Grid.Column="1" ClipToBounds="True">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap" Height="{DynamicResource ListTitleHeight}" ClipToBounds="True"/>
                                <TextBlock Text="{Binding Preview}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource MutedBrush}" FontSize="12" Height="{DynamicResource ListPreviewHeight}" ClipToBounds="True" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSnippet}" Value="False">
                                <Setter TargetName="DragHandle" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CanReorder}" Value="False">
                                <Setter TargetName="DragHandle" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </AdornerDecorator>
            <Grid Grid.Row="5" Margin="2,10,2,0">
                <TextBlock x:Name="StatusText" Text="點一下即可複製" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
